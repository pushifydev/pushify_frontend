# Backend API URL (app requests — local dev)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional: API URL shown in /docs (defaults to https://api.pushify.dev/api/v1)
# NEXT_PUBLIC_DOCS_API_URL=https://api.pushify.dev/api/v1

# Optional: Google Analytics 4 — set to your Measurement ID to enable (GA loads only when set)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Sentry (install @sentry/nextjs when enabling)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# E2E (Playwright — local: `npm run dev` then `npm run test:e2e:smoke`)
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# E2E_EMAIL=          # optional — authenticated dashboard tests
# E2E_PASSWORD=
# E2E_SERVER_ID=      # optional — server detail tests
